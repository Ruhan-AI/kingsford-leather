{
  "name": "kingsford-leather",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run images:validate && npm run images:variants && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run build",
    "export:zip": "npm run build && node scripts/create_hostinger_zip.js",
    "images:variants": "node scripts/generate-image-variants.mjs",
    "images:validate": "node scripts/validate-images.mjs",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.34.0",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "archiver": "^8.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
