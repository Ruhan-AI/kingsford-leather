# Copy to .env.local for development. Never commit a filled-in copy.
# Nothing that is a secret may carry the NEXT_PUBLIC_ prefix — that prefix
# inlines the value into the JavaScript bundle served to every visitor.

NEXT_PUBLIC_SITE_URL=https://kingsfordleather.com
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── AI fitting room ────────────────────────────────────────────────────────
# Off unless explicitly set to "true". An unset flag must never authorise spend.
TRY_ON_FEATURE_ENABLED=false

# "gemini" — image composition via Gemini ("Nano Banana"). The intended
#            provider: it fits the garment to the workshop dress form and works
#            straight from the ordinary listing photograph. Needs GEMINI_API_KEY.
# "vertex" — Google Cloud virtual-try-on-001. Built to dress a photographed
#            person, so keep it in reserve for the photo-upload path.
# "mock"   — watermarked local stand-in, costs nothing.
# A provider that is selected but unconfigured falls back to the mock.
TRY_ON_PROVIDER=gemini

# Leave unset to use the provider's own default
# (gemini-3.1-flash-image for gemini, virtual-try-on-001 for vertex).
# This model family versions quickly — override here, never in code.
TRY_ON_MODEL_ID=

# ── Gemini ─────────────────────────────────────────────────────────────────
# From Google AI Studio. Server-only: never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Successful generations per visitor per day.
TRY_ON_DAILY_DEVICE_LIMIT=3
# Hard monthly ceiling in USD, at Google's US$0.06 per generated image.
TRY_ON_MONTHLY_BUDGET_USD=150

# Salt for the hashed rate-limit key. Set to any long random string.
RATE_LIMIT_SALT=

# ── Google Cloud (only for TRY_ON_PROVIDER=vertex) ─────────────────────────
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=northamerica-northeast1
# The full service-account JSON, either raw or base64-encoded.
GOOGLE_CLOUD_SERVICE_ACCOUNT_JSON=

# ── Durable rate limit / budget (required before real traffic) ─────────────
# Without these the limiter and budget live in process memory, so each
# serverless instance keeps its own count and the real ceiling is
# (instances x limit). See src/lib/try-on/rate-limit.ts.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

SENTRY_DSN=

# Cost of one generated image, in USD. Keep this matched to the model actually
# in use or the monthly budget stops meaning anything.
#   gemini-3.1-flash-image       ~0.067 per 1K image   (provider default)
#   gemini-3.1-flash-lite-image  ~0.034 per 1K image   (about half price)
#   virtual-try-on-001            0.06  per image
TRY_ON_COST_PER_IMAGE_USD=0.067
